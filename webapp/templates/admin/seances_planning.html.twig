{% extends 'baseadmin.html.twig' %}

{% block title %}Planning des séances{% endblock %}

{% block content %}
   
   <link rel="stylesheet" href="/css/jq.schedule.css">
   
   <div id="planning_seances" class="planning_seances">
       
        <h2>Planning des séances - <span id="info_planning">Nantes, Aujourd'hui {{ date()|format_date('long') }}</span></h2>
        
        <div class="row">
            <div class="col-md-12 mb-3">
             
                 {% set choix_cinema_id = "" %}
                 <div class="col-12 ligne_menu mb-3">
                     <div class="menu_cinemas">
                         <ul class="nav nav-pills px-3 ps-0">
                             {% for cinema_id, cinema_nom in cinemas %}
                                 {% if loop.index == 1 %}
                                     {% set choix_cinema_id = cinema_id %}
                                 {% endif %}
                                 {% set class_active = (loop.index == 1) ? "active" : "" %}
                                 <li class="nav-item">
                                     <a class="nav-link {{ class_active }} lien_choix_cinema lien_c{{ cinema_id }}" data-cinema-id="{{ cinema_id }}">{{ cinema_nom }}</a>
                                 </li>
                             {% endfor %}
                         </ul>
                     </div>
                     
                     {% set date_jour = "" %}
                     <div class="menu_jours">
                         <ul class="nav nav-pills px-3 pe-0">
                             {% for date_key, jour_fr in dates %}
                                 {% if loop.index == 1 %}
                                    {% set date_jour = date_key %}
                                 {% endif %}
                                 {% set class_active = (loop.index == 1) ? "active" : "" %}
                                 <li class="nav-item">
                                     <a class="nav-link {{ class_active }} lien_choix_date lien_j{{ loop.index }}" data-filtre-date="{{ date_key }}" data-nom-jour="j{{ loop.index }}">{{ jour_fr }}</a>
                                 </li>
                             {% endfor %}
                         </ul>
                     </div>
                     
                 
                 </div>
                 
                 <div class="col-12 ligne_menu mb-3">
                     <div class="menu_films">
                         <p><b>Films actuellement au catalogue :</b></p>
                        <p id="liste_films"></p>
                     </div>
                     
                     <div class="menu_techno">
                         <p><b>Technologie :</b></p>
                         <p id="liste_qualite">
                             <span class="badge badge_choix_techno" data-choix-techno="3D">Projection en 3D</span>
                         </p>
                     </div>
                 </div>
                 
                 
                 <div id="seances_planning" class="mb-2">
            </div>
        </div>
        
        <div class="row">
            <div class="col-md-12 mb-3">
               <h6 class="text-center text-success">
                    Utilisation : Choisir un film en cliquant dessus pour le sélectionner,
                    puis cliquer sur le planning à l'heure souhaitée pour le programmer.
               </h6>
            </div>
        </div>
        
        <div class="row">
            <div class="col-md-12 mb-3">
                <div class="d-inline-block me-3">
                     <button type="button" class="btn btn-outline-success btn-lg btn-block fw-bold" id="btn_seances_planning">Enregistrer</button>
                </div>
                <div class="d-inline-block">
    
                     <div class="form-check form-switch">
                         <input class="form-check-input" type="checkbox" role="switch" id="copier_planning">
                         <label class="form-check-label" for="copier_planning">Copier ce planning vers tous les cinémas & dates</label>
                     </div>
                 
                     <input type="hidden" name="choix_date" value="{{ date_jour }}" id="choix_date">
                     <input type="hidden" name="cinema_id" value="{{ choix_cinema_id }}" id="cinema_id">
                </div>
            </div>
        </div>
   
   </div>


{% endblock %}

{% block scripts_supp %}
   
{#   <script src="/js/jquery-3.7.1.min.js"></script>#}
   <script src="/js/jquery-ui.min.js"></script>
   <script src="/js/jq.schedule.js"></script>
   
   <script type="text/javascript">
       
       const data_films = {{ data_films|json_encode|raw }};
       const data_seances_raw = {{ seances|raw }};
   
   </script>
   
{% endblock %}